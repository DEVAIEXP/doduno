# Runtime mode
DOD_USE_LOCAL_DATA=True
DOD_DISABLE_TTS=True
DOD_USE_LOCAL_API=False

# Local API endpoints
TTS_API_URL=http://127.0.0.1:8000/generate_api
TTS_API_MODE=gradio
LLM_URL=http://127.0.0.1:7880

# API authentication
TTS_API_KEY="your_api_key"
LLM_API_KEY="your_api_key"

# Remote endpoint priority
LLM_URL_PRIORITY=fallback
TTS_URL_PRIORITY=fallback

# Hugging Face datasets
# Optional. Leave blank unless your remote datasets are private.
HF_TOKEN=
DOD_INFERENCE_MAPPER_DATASET_REPO_ID=your_repo_id
DOD_INFERENCE_MAPPER_DATASET_REVISION=main
DOD_LEADERBOARD_DATASET_REPO_ID=your_repo_id
